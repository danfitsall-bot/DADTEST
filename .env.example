# ============================================================
# INVESTMENT TRACKER — Environment Variables
# Copy this file to .env.local for local development
# Set all variables in Vercel Dashboard > Settings > Environment Variables
# ============================================================

# Gmail SMTP Credentials
# Use an App Password, NOT your regular Gmail password.
# Create one at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Recipient email for daily investment updates
RECIPIENT_EMAIL=your-email@gmail.com

# Vercel Blob Storage (for portfolio persistence)
# Auto-populated when you run: vercel env pull
# Or create a Blob store in Vercel Dashboard > Storage > Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# Cron job security secret (any random string you choose)
# Set this in Vercel and it will be sent with cron requests
CRON_SECRET=your-super-secret-random-string
